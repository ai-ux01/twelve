# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profitterminal?schema=public"

# MongoDB (Candle Data - bot-ai database)
MONGODB_URI="mongodb://localhost:27017/bot-ai"

# Market Data Provider (Kite Connect)
KITE_API_KEY=""
KITE_API_SECRET=""

# Broker API (Kotak Neo)
KOTAK_API_KEY=""
KOTAK_API_SECRET=""

# Kotak Neo Trading API (Live Trading)
KOTAK_NEO_CONSUMER_KEY=""
KOTAK_NEO_CONSUMER_SECRET=""
KOTAK_NEO_ACCESS_TOKEN=""
KOTAK_NEO_SESSION_TOKEN=""

# AI Provider Configuration
# Options: "openai" (external API), "ollama" (local LLM)
AI_PROVIDER="ollama"

# OpenAI Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=""

# Ollama Configuration (when AI_PROVIDER=ollama)
# Ensure Ollama is installed and running: https://ollama.ai
# Pull a model first: ollama pull llama2
OLLAMA_BASE_URL="http://localhost:11434"

# AI Model Selection
# For OpenAI: "gpt-4", "gpt-3.5-turbo", etc.
# For Ollama: "llama2", "mistral", "codellama", "mixtral", etc.
AI_MODEL=""  # Defaults: "gpt-4" for OpenAI, "llama2" for Ollama

# Service URLs
BACKEND_API_URL="http://localhost:4000"
QUANT_ENGINE_URL="http://localhost:8000"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Risk Parameters (can be overridden per user in database)
DEFAULT_MAX_POSITION_SIZE=100000
DEFAULT_MAX_DRAWDOWN=0.05
DEFAULT_MAX_PORTFOLIO_EXPOSURE=0.30
DEFAULT_STOP_LOSS=0.02

# Historical Market Data Configuration
MARKET_DATA_RETENTION_YEARS=2
STORE_TICKS=false
TICK_BATCH_SIZE=1000
TICK_BATCH_INTERVAL_MS=5000
SYNC_ON_STARTUP=true
RETENTION_CRON="0 2 * * *"
BROKER_RATE_LIMIT_RPS=10

# HSM Market Feed
HSM_WS_URL=wss://mlhsm.kotaksecurities.com
MOCK_MARKET_DATA=true
ATM_STRIKE_RANGE=5
MOCK_TICK_INTERVAL=1000
